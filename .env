;
; System level config
;

; System environment
SYSTEM_ENVIRONMENT=0                            ; Environment PRODUCTION = 1 / DEVELOPMENT = 0

; Global Auto-Increment counter detail
ENABLE_SYSTEM_LEVEL_PRIMARY_KEY=1               ; 1 = true / 0 = false
SYSTEM_LEVEL_PRIMARY_KEY_MODE='Cache'           ; Globally configured Cache / Database
SYSTEM_LEVEL_PRIMARY_KEY_NAME='global_counter'  ; Key or Table

; Master database on global server
SYSTEM_MASTER_DB='customer_master'     ; contains all entities necessary for a new customer

; Customer Table
SYSTEM_CUSTOMER_TABLE='customer'

;
; Route related config (to allow / now to allow) settings
;
; Listing available routes
SYSTEM_ENABLE_RELOAD_CACHE=1                    ; 1 = true / 0 = false
SYSTEM_ROUTE_REQUEST_KEYWORD='routes'
; Reload
SYATEM_ENABLE_RELOAD_CACHE=1                    ; 1 = true / 0 = false
SYSTEM_RELOAD_REQUEST_KEYWORD='reload'
SYATEM_RELOAD_CACHE_CIDR=''

; ---- Data representation --------
; Supported: JSON/XML/XSLT/HTML/PHP
SYSTEM_INPUT_REPRESENTATION='JSON'              ; JSON/XML - Input Data Representation
SYSTEM_OUTPUT_REPRESENTATION='JSON'             ; JSON/XML/XSLT/HTML/PHP - Output Data Representation

;
; Customer DB level config (represented by customer id)
;

; Container related configs for customer
OUTPUT_PERFORMANCE_STATS=1               ; Add performance stats in JSON output: 1 = true / 0 = false
DISABLE_REQUESTS_VIA_PROXIES=1           ; 1 = true / 0 = false

; Setting for encryption
SECRET='changeme'                        ; hash_hmac secret
PAYLOAD_IN_RESPONSE='Payload'            ; 1 = true / 0 = false

; Reload request
ENABLE_RELOAD_CACHE=1                    ; 1 = true / 0 = false
RELOAD_REQUEST_KEYWORD='reload'
RELOAD_CACHE_CIDR=''

; API authentication modes - Token / PHP Session (Cookie based sessions)
MAX_CONCURRENT_LOGIN=2                   ; Simultaneous login limit
MAX_CONCURRENT_LOGIN_WINDOW=60           ; Concurrent access window in seconds

;
; --- Containers detail -------
;


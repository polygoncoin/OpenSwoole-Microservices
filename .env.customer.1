;
; Global DB level config (represented by zero))
;

;; Domain name settings
PUBLIC_DOMAIN_NAME='customer001.localhost'
PRIVATE_WEB_DOMAIN_NAME='web.customer001.localhost'
PRIVATE_API_DOMAIN_NAME='api.customer001.localhost'

;; Customer config directory
CUSTOMER_CONFIG_DIRECTORY='CustomerConfigSet.1'

;; Enable
OUTPUT_PERFORMANCE_STATS=true
DISABLE_PROXY_REQUEST=true

;; Encryption secret setting
SECRET='changeme'

;; Concurrent logins
ENABLE_CONCURRENT_LOGIN=true
CONCURRENT_LOGIN_COUNT=10

; ;Payload settings
ENABLE_PAYLOAD_IN_RESPONSE=true
PAYLOAD_KEY_IN_RESPONSE='Payload'

;; Default per page (records per page)
DEFAULT_PER_PAGE_COUNT=10
MAX_PER_PAGE_COUNT=1000

;; Customer level private domain login lifetime
TOKEN_LIFETIME=3600;
SESSION_LIFETIME=3600


;
; Route related config (to allow / now to allow) settings
;

;; Exact keyword routes
ENABLE_RELOAD=true
ENABLE_ROUTES=true
; Keywords
RELOAD_KEYWORD='reload'
ROUTES_KEYWORD='routes'

;; Supplement feature prefixed to route with slash
ENABLE_CRON=true
ENABLE_CUSTOM=true
ENABLE_DROPBOX=true
ENABLE_THIRDPARTY=true
ENABLE_UPLOAD=true
; Supplement feature Keywords
CRON_KEYWORD='cron'
CUSTOM_KEYWORD='custom'
DROPBOX_KEYWORD='cdn'
THIRDPARTY_KEYWORD='thirdParty'
UPLOAD_KEYWORD='upload'
; Supplement functions keyword to append
APPEND_SUPPLEMENT_FUNCTION_KEYWORD='Process'

;; Keyword to append to all route with slash
ENABLE_EXPLAIN=true
ENABLE_IMPORT=true
ENABLE_IMPORT_SAMPLE=true
; Keywords
EXPLAIN_KEYWORD='explain'
IMPORT_CSV_KEYWORD='import'
IMPORT_SAMPLE_KEYWORD='import-sample'

;; Download client location for export CSV
ENABLE_EXPORT=true
EXPORT_KEYWORD='export'
EXPORT_CLIENT_LOCATION='/usr/local/bin/mysql'


;
; Rate limiting config
;


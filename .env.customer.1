;
; Rate limiting config
;

; Rate limit open traffic (not limited by allowed IPs/CIDR and allowed Rate Limit to user)
RATE_LIMIT_IP_PREFIX='RL:C:IP:'
; Route based Rate Limiting (RRL) Key prefix used in Redis
RATE_LIMIT_ROUTE_PREFIX='RL:C:R:'
; User Per IP based Rate Limiting (UIRL) Key prefix used in Redis
RATE_LIMIT_IP_ROUTE_PREFIX='RL:C:UIP:' ;
; Group based Rate Limitng (GRL) Key prefix used in Redis
RATE_LIMIT_GROUP_PREFIX='RL:C:G:'
; User Per IP based Rate Limiting (UIRL) Key prefix used in Redis
RATE_LIMIT_IP_GROUP_PREFIX='RL:C:UIP:'
; User based Rate Limitng (URL) Key prefix used in Redis
RATE_LIMIT_USER_PREFIX='RL:C:U:'
; User Per IP based Rate Limiting (UIRL) Key prefix used in Redis
RATE_LIMIT_IP_USER_PREFIX='RL:C:UIP:'
; User Login Rate Limiting (ULRL) Key prefix used in Redis
RATE_LIMIT_USER_LOGIN_PREFIX='RL:C:UL:'

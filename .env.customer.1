ENABLE_RATE_LIMITING_ROUTE_IP=true
ENABLE_RATE_LIMITING_GROUP_IP=true
ENABLE_RATE_LIMITING_GROUP_ROUTE_IP=true
ENABLE_RATE_LIMITING_USER_IP=true
ENABLE_RATE_LIMITING_USER_ROUTE_IP=true
;; Login requests
ENABLE_RATE_LIMITING_LOGIN=true
ENABLE_RATE_LIMITING_LOGIN_IP=true
ENABLE_RATE_LIMITING_EACH_USER_LOGIN=true
ENABLE_RATE_LIMITING_EACH_USER_LOGIN_IP=true


